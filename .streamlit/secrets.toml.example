# Copie para .streamlit/secrets.toml (ignorado pelo Git) e preencha.
# No Streamlit Cloud: App > Settings > Secrets (cole este mesmo conteúdo).
# Provedores gratuitos de PostgreSQL: Neon, Supabase, Railway, Aiven.
[postgres]
host = "ep-xxxx.sa-east-1.aws.neon.tech"
port = 5432
dbname = "neondb"
user = "usuario"
password = "senha"
sslmode = "require"
